# ── Goharu 环境变量模板 ──────────────────────────────────────────
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 被 gitignore，绝不会进仓库。

# ── LLM（必填，任一 Anthropic 兼容端点）──
# config.yaml model.large-language-model 的 api_key_env 指向这里某个变量
ANTHROPIC_API_KEY=          # MiniMax / 官方 Anthropic 端点
ZHIPU_API_KEY=              # deepseek-flash / GLM / kimi 端点复用此变量

# ── QQ Bot（可选，启用 qqbot channel 时必填）──
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=

# ── Tavily 搜索 MCP（可选）──
TAVILY_API_KEY=

# ── AgentNet / HaruNet（可选，智能体组网）──
# AGENTNET_HUB_URL=ws://your-hub:6000
