# Goharu 手动测试用的全新干净环境：只装基础工具（git/python3/venv/node/npm/curl），
# 进容器即是空 bash，仓库由你亲手跑一行 bootstrap 拉取安装。
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        git curl ca-certificates xz-utils python3 python3-venv python3-pip bash; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y --allowerasing git curl ca-certificates xz python3.11 python3.11-pip bash; \
      alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 20 >/dev/null 2>&1 || true; \
      alternatives --set python3 /usr/bin/python3.11 >/dev/null 2>&1 || true; \
      dnf clean all; \
    else \
      echo "unsupported base" >&2; exit 1; \
    fi

# Node 22 LTS（Ink 7 要求 >=22）。
# 用 npmmirror 国内二进制源，apt/dnf 系通用（x64）。
ARG NODE_VER=v22.20.0
RUN curl -fsSL "https://registry.npmmirror.com/-/binary/node/${NODE_VER}/node-${NODE_VER}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version

WORKDIR /root
CMD ["/bin/bash"]
