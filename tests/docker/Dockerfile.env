# Goharu 手动测试用的全新干净环境：只装基础工具（git/python3/venv/node/npm/curl），
# 进容器即是空 bash，仓库由你亲手跑一行 bootstrap 拉取安装。
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        git curl ca-certificates python3 python3-venv python3-pip nodejs npm bash; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y git curl ca-certificates python3 python3-pip nodejs npm bash; \
      dnf clean all; \
    else \
      echo "unsupported base" >&2; exit 1; \
    fi

WORKDIR /root
CMD ["/bin/bash"]
